{
  "name": "methodology_flowchart",
  "title": "CAN IDS methodology",
  "caption": "Four detectors, with and without vehicle physics, are built from normal driving only, judged at thresholds frozen before testing, and compared on attacks injected into an unseen real-car recording.",
  "page": "a4-landscape",
  "writing": {"forbid_dashes": true, "banned_words": [], "max_title_words": 5},
  "elements": [
