    {"type": "group", "id": "g3", "x": 432, "y": 196, "w": 722, "h": 250, "tab": "3 · Detectors, per seed"},
    {"type": "group", "id": "g4", "x": 46, "y": 482, "w": 1108, "h": 350, "tab": "4 · Test"},

    {"type": "row", "y": 46, "h": 76, "x0": 66, "x1": 950, "gap": 24, "items": [
      {"type": "box", "id": "data", "tone": "peach", "number": 1, "title": "X-CANIDS signals", "size": 12,
       "lines": ["7 recordings, 688 signals", "checked: 5 ms grid, no gaps"]},
      {"type": "box", "id": "split", "tone": "peach", "number": 2, "title": "Split by recording", "size": 12,
       "lines": ["train, validation, test", "recording 6: test only"]},
      {"type": "box", "id": "fit", "tone": "purple", "number": 3, "title": "Fit relations", "size": 12,
       "lines": ["R1 to R5, least squares, ≥ 5 km/h", "keep if R^{2} ≥ 0.9 (our choice)"]},
      {"type": "diamond", "id": "kept", "w": 200, "title": "Any relation kept?", "lines": ["on validation"]}
    ]},
    {"type": "box", "id": "stop", "x": 974, "y": 61, "w": 160, "h": 46, "tone": "red", "title": "Stop and re-plan",
