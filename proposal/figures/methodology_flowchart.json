    {"type": "arrow", "from": "score.bottom", "to": "side.top@0.2386", "style": "dashed"},

    {"type": "box", "id": "nogain", "x": 618, "y": 620, "w": 240, "h": 76, "tone": "red", "title": "No gain found",
