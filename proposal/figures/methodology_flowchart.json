    {"type": "frame", "id": "dets", "x": 452, "y": 218, "w": 682, "h": 104, "tone": "blue", "number": 6, "title": "Four detectors, same inputs",
     "cell_arrows": false, "cells": [
       {"title": "D1", "line": "physics only"},
       {"title": "D2", "line": "autoencoder"},
       {"title": "D3", "line": "D2 + violation inputs"},
       {"title": "D4", "line": "D2 + *λ* × physics loss"}]},
    {"type": "arrow", "from": "kept.bottom", "to": "dets.top", "label": "YES: kept relations", "label_at": [850, 176], "label_anchor": "start"},

    {"type": "row", "y": 356, "h": 76, "x0": 452, "x1": 1134, "gap": 24, "items": [
      {"type": "box", "id": "train", "tone": "green", "number": 7, "title": "Train models", "size": 12,
       "lines": ["training drives only", "*λ* picked on validation"]},
      {"type": "diamond", "id": "seeds", "w": 200, "title": "All seeds done?", "lines": ["5 seeds, 3 in core"]},
      {"type": "box", "id": "thr", "tone": "cyan", "number": 8, "title": "Freeze thresholds", "size": 12,
