    {"type": "arrow", "from": "kept.right", "to": "stop.left", "label": "NO"},

    {"type": "box", "id": "inject", "x": 66, "y": 218, "w": 330, "h": 76, "tone": "peach", "number": 4, "title": "Attack injector",
     "lines": ["offset, drift, freeze, replay", "whole message, consistent group"]},
    {"type": "box", "id": "copies", "x": 66, "y": 330, "w": 330, "h": 76, "tone": "peach", "number": 5, "title": "Attacked test copies",
