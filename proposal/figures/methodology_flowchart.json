    {"type": "box", "id": "rqs", "x": 882, "y": 620, "w": 252, "h": 76, "tone": "purple", "number": 13, "title": "Answer RQ2 to RQ4", "size": 12,
     "lines": ["inputs vs loss, physics only", "attacks nobody caught"]},
    {"type": "arrow", "from": "gain.bottom", "to": "nogain.top", "label": "NO", "label_side": "right"},
    {"type": "arrow", "from": "locate.bottom", "to": "rqs.top"},
    {"type": "arrow", "from": "nogain.right", "to": "rqs.left"},

    {"type": "box", "id": "paper", "x": 66, "y": 736, "w": 1068, "h": 76, "tone": "orange", "number": 14, "title": "Paper and package", "thick": true,
     "lines": ["one results table per research question, every number traced to a saved results file",
               "code, split, fitted relations, thresholds and the decisions log; dataset files not shared"]},
    {"type": "arrow", "from": "side.bottom", "to": "paper.top@0.2472", "style": "dashed"},
    {"type": "arrow", "from": "rqs.bottom", "to": "paper.top@0.882"}
  ]
}
