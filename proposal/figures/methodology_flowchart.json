    ]},
    {"type": "arrow", "from": "copies.bottom@0.3", "to": "score.top@0.4", "label": "attacked copies", "label_at": [176, 470], "label_anchor": "start"},
    {"type": "arrow", "from": "thr.bottom", "to": "score.top@0.85", "via_y": 464, "label": "frozen thresholds", "label_at": [600, 458], "label_anchor": "start"},

    {"type": "box", "id": "side", "x": 66, "y": 620, "w": 528, "h": 76, "tone": "cyan", "number": 12, "title": "Side check",
